Testing set_user_rules() with default rules (https sticky + default_rule_v4 + default_rule_v6).

-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();
m.update_iface_to_table();
m.nft_file('create', 'rules');
m.set_user_rules();
m.nft_file('install', 'rules');
print(global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/11-mwan4-rules.nft'));
-- End --

